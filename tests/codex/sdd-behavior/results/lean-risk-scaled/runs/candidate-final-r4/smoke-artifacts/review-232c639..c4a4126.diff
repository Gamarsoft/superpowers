+import threading
+import unittest
+from concurrent.futures import ThreadPoolExecutor
+
+from src.reservations import reserve_once
+
+
+class ReserveOnceTests(unittest.TestCase):
+    def test_first_reservation_debits_balance(self):
+        self.assertEqual(
+            reserve_once(1_000, 250, "reserved-key"),
+            ("reserved", 750),
+        )
+
+    def test_insufficient_funds_leave_balance_unchanged(self):
+        self.assertEqual(
+            reserve_once(100, 101, "insufficient-key"),
+            ("insufficient_funds", 100),
+        )
+
+    def test_sequential_duplicate_does_not_debit_again(self):
+        self.assertEqual(
+            reserve_once(500, 200, "sequential-key"),
+            ("reserved", 300),
+        )
+        self.assertEqual(
+            reserve_once(500, 200, "sequential-key"),
+            ("already_reserved", 300),
+        )
+
+    def test_reserved_duplicate_replays_first_balance_when_arguments_change(self):
+        self.assertEqual(
+            reserve_once(1_000, 250, "changed-reserved-key"),
+            ("reserved", 750),
+        )
+        self.assertEqual(
+            reserve_once(9_999, 1_000, "changed-reserved-key"),
+            ("already_reserved", 750),
+        )
+
+    def test_insufficient_duplicate_replays_first_balance_when_arguments_change(self):
+        self.assertEqual(
+            reserve_once(100, 101, "changed-insufficient-key"),
+            ("insufficient_funds", 100),
+        )
+        self.assertEqual(
+            reserve_once(1_000, 100, "changed-insufficient-key"),
+            ("already_reserved", 100),
+        )
+
+    def test_concurrent_duplicate_replays_winning_balance(self):
+        start = threading.Barrier(2)
+        calls = [(1_000, 300), (900, 100)]
+
+        def reserve(call):
+            start.wait()
+            return reserve_once(*call, "concurrent-key")
+
+        with ThreadPoolExecutor(max_workers=2) as executor:
+            results = list(executor.map(reserve, calls))
+
+        self.assertIn(
+            results,
+            [
+                [("reserved", 700), ("already_reserved", 700)],
+                [("already_reserved", 800), ("reserved", 800)],
+            ],
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
