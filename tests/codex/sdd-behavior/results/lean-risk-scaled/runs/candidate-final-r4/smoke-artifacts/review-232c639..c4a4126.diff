+import threading
+
+
+_resulting_balances: dict[str, int] = {}
+_registry_lock = threading.Lock()
+
+
+def reserve_once(
+    balance_cents: int,
+    amount_cents: int,
+    key: str,
+) -> tuple[str, int]:
+    with _registry_lock:
+        if key in _resulting_balances:
+            return "already_reserved", _resulting_balances[key]
+
+        if balance_cents < amount_cents:
+            status = "insufficient_funds"
+            resulting_balance = balance_cents
+        else:
+            status = "reserved"
+            resulting_balance = balance_cents - amount_cents
+
+        _resulting_balances[key] = resulting_balance
+        return status, resulting_balance
