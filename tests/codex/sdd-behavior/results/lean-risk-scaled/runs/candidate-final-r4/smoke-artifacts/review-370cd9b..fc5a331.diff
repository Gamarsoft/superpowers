+import threading
+import unittest
+from concurrent.futures import ThreadPoolExecutor
+
+from src.reservations import reserve_once
+
+
+class ReserveOnceTests(unittest.TestCase):
+    def test_first_reservation_debits_balance(self):
+        self.assertEqual(
+            reserve_once(1_000, 250, "reserved-key"),
+            ("reserved", 750),
+        )
+
+    def test_insufficient_funds_leave_balance_unchanged(self):
+        self.assertEqual(
+            reserve_once(100, 101, "insufficient-key"),
+            ("insufficient_funds", 100),
+        )
+
+    def test_sequential_duplicate_does_not_debit_again(self):
+        self.assertEqual(
+            reserve_once(500, 200, "sequential-key"),
+            ("reserved", 300),
+        )
+        self.assertEqual(
+            reserve_once(500, 200, "sequential-key"),
+            ("already_reserved", 300),
+        )
+
+    def test_concurrent_duplicate_is_applied_once(self):
+        start = threading.Barrier(2)
+
+        def reserve():
+            start.wait()
+            return reserve_once(1_000, 300, "concurrent-key")
+
+        with ThreadPoolExecutor(max_workers=2) as executor:
+            results = list(executor.map(lambda _: reserve(), range(2)))
+
+        self.assertCountEqual(
+            results,
+            [("reserved", 700), ("already_reserved", 700)],
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
