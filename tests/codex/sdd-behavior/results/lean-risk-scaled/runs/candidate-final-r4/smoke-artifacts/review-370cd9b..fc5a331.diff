+import threading
+
+
+_applied_keys: set[str] = set()
+_registry_lock = threading.Lock()
+
+
+def reserve_once(
+    balance_cents: int,
+    amount_cents: int,
+    key: str,
+) -> tuple[str, int]:
+    with _registry_lock:
+        if key in _applied_keys:
+            if balance_cents >= amount_cents:
+                return "already_reserved", balance_cents - amount_cents
+            return "already_reserved", balance_cents
+
+        _applied_keys.add(key)
+        if balance_cents < amount_cents:
+            return "insufficient_funds", balance_cents
+        return "reserved", balance_cents - amount_cents
